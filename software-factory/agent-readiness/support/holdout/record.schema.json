{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-readiness/holdout-record@1",
  "title": "What the holdout steward may put in the repository: enumerations, counts, hashes, commit ids and dates, and no free text",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "date", "commitment"],
  "properties": {
    "schema": { "const": "agent-readiness/holdout-record@1" },
    "kind": { "enum": ["commitment", "look"] },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "commitment": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the salted manifest: repos, commits and truth for every set" },
    "set": { "enum": ["validation", "test"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "toolCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scripts", "rubric", "protocol"],
      "properties": {
        "scripts": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "rubric": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "protocol": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repos", "dropped", "infraLost", "swapped", "collisions", "tripwire"],
      "properties": {
        "repos": { "type": "integer", "minimum": 0 },
        "dropped": { "type": "integer", "minimum": 0, "description": "Truth items the two writers disagreed on" },
        "infraLost": { "type": "integer", "minimum": 0 },
        "swapped": { "type": "integer", "minimum": 0 },
        "collisions": { "type": "integer", "minimum": 0 },
        "tripwire": { "type": "integer", "minimum": 0 }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["environment", "arm", "repos", "critical", "rates", "classes"],
        "properties": {
          "environment": { "enum": ["container", "disposable_vm", "host", "none"] },
          "arm": { "enum": ["scripted", "agent"] },
          "repos": { "type": "integer", "minimum": 0 },
          "critical": {
            "type": "object",
            "additionalProperties": false,
            "required": ["K1", "K2", "K3", "K4", "K5", "K6", "K7"],
            "patternProperties": { "^K[1-7]$": { "type": "integer", "minimum": 0 } }
          },
          "rates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["R1", "R2", "R3", "R4", "R5", "R6"],
            "patternProperties": {
              "^R[1-6]$": {
                "type": "object",
                "additionalProperties": false,
                "required": ["hit", "of", "rate", "low", "high"],
                "properties": {
                  "hit": { "type": "integer", "minimum": 0 },
                  "of": { "type": "integer", "minimum": 0 },
                  "rate": { "type": ["number", "null"] },
                  "low": { "type": ["number", "null"] },
                  "high": { "type": ["number", "null"] }
                }
              }
            }
          },
          "classes": {
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^(K[1-7]|R1_missing|R1_misplaced|R2_no_command|R2_other_command|R3_missing|R3_level_0|R3_unproven|R3_undetermined|R3_not_assessed|R4_rejected|R5_disagree|R6_off|R6_not_reported)$": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "verdict": { "enum": ["PASS", "FAIL", null] },
    "failed": { "type": "array", "items": { "enum": ["K1", "K2", "K3", "K4", "K5", "K6", "K7", "R1", "R2", "R3", "R4", "R5", "R6"] } }
  }
}
