{
  "name": "workspace-globs",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workspace-globs",
      "version": "1.0.0",
      "workspaces": [
        "packages/**",
        "!packages/legacy/**"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/paging": {
      "resolved": "packages/group/paging",
      "link": true
    },
    "node_modules/pricing": {
      "resolved": "packages/pricing",
      "link": true
    },
    "packages/group/paging": {
      "version": "1.0.0"
    },
    "packages/pricing": {
      "version": "1.0.0"
    }
  }
}
