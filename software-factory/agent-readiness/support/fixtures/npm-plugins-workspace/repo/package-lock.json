      "resolved": "plugins/auth",
      "link": true
    },
    "node_modules/cache": {
      "resolved": "plugins/cache",
      "link": true
    },
    "node_modules/metrics": {
      "resolved": "plugins/metrics",
      "link": true
    },
    "packages/core": {
      "version": "1.0.0"
    },
    "plugins/auth": {
      "version": "1.0.0"
    },
    "plugins/cache": {
      "version": "1.0.0"
    },
    "plugins/metrics": {
      "version": "1.0.0"
    }
  }
}
