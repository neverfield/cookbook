{
  "name": "plugin-host",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "plugin-host",
      "version": "1.0.0",
      "workspaces": [
        "packages/*",
        "plugins/*"
      ]
