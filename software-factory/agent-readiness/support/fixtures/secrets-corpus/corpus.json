    {
      "file": "src/mediabot/settings.py",
      "lines": [
        "import os",
        ["AWS_ACCESS_KEY_ID = '", "AKIA", "QQQQFAKEKEY22222", "'"],
        "DATABASE_URL = os.environ.get('DATABASE_URL', 'postgres://localhost/mediabot')"
      ],
      "expect": [{ "line": 2, "class": "provider_token", "blocking": true }]
    },
    {
