{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-readiness audit",
  "type": "object",
  "required": ["schema", "id", "kind", "createdAt", "state", "repo", "scenarios", "tier", "rubric", "skill", "seed", "environment", "profile", "assets", "contract", "instructions", "safety", "evidence", "mutants", "outcomes", "narration"],
  "properties": {
    "schema": { "const": "agent-readiness/audit@1" },
    "id": { "type": "string", "pattern": "^aud-" },
    "kind": { "const": "audit" },
    "state": { "enum": ["draft", "sealed"] },
    "repo": {
      "type": "object",
      "required": ["name", "commit", "dirtyTree"],
      "properties": { "name": { "type": "string" }, "commit": { "type": "string" }, "dirtyTree": { "type": "boolean" }, "shallow": { "type": "boolean" }, "submodulesMissing": { "type": "array", "items": { "type": "string" } }, "lfsPointers": { "type": "integer", "minimum": 0 } }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "components"],
        "properties": { "id": { "enum": ["first_pr", "bug_fixes", "features", "repo_wide"] }, "components": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } }
      }
    },
    "tier": { "enum": ["read-only", "local-exec", "external-systems"] },
    "skill": {
      "type": "object",
      "required": ["version", "scriptsDigest", "rubricDigest", "release"],
      "properties": { "scriptsDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "rubricDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "seed": { "type": "object", "required": ["value", "pinned"], "properties": { "pinned": { "type": "boolean" } } },
    "environment": {
      "type": "object",
      "required": ["containerRuntime", "image", "registryEnv", "inheritEnv"],
      "properties": {
        "registryEnv": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" } },
        "images": { "type": "array", "items": { "type": "object", "required": ["image", "components", "started"], "properties": { "image": { "type": "string" }, "digest": { "type": "string" }, "components": { "type": "array", "items": { "type": "string" } }, "started": { "type": "boolean" }, "notRun": { "type": "string" } } } },
        "toolchains": { "type": "array", "items": { "type": "object", "required": ["spec", "image", "reason", "added"], "properties": { "spec": { "type": "string" }, "image": { "type": "string" }, "reason": { "type": "string" }, "added": { "type": "boolean" } } } },
        "userEntryMissing": { "type": "object", "required": ["uid", "images"], "properties": { "uid": { "type": "string" }, "images": { "type": "array", "items": { "type": "string" } } } },
        "proofEnv": { "type": "object", "required": ["kind", "id", "imageSource", "network", "canary", "proves"], "properties": { "kind": { "enum": ["container", "disposable_vm", "host"] }, "id": { "type": "string" }, "imageSource": { "enum": ["audit", "repo", "override", null] }, "detectedBy": { "type": "array", "items": { "type": "string" } }, "network": { "enum": ["cut", "on", null] }, "canary": { "type": "object", "required": ["ok", "checks"], "properties": { "ok": { "type": "boolean" }, "checks": { "type": "array", "items": { "type": "object", "required": ["id", "ok", "detail"], "properties": { "id": { "enum": ["mount_visible", "mount_writable", "run_user", "network_cut", "git_identity"] }, "ok": { "type": "boolean" }, "detail": { "type": "string" } } } } } }, "proves": { "type": "boolean" } } }
      }
    },
    "masked": { "type": "array", "items": { "type": "object", "required": ["type", "where"], "properties": { "type": { "type": "string" }, "where": { "type": "string" } } } },
    "profile": { "type": ["object", "null"] },
    "contract": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "component", "cwd", "command", "source", "reason", "timeoutSec"],
        "properties": { "kind": { "enum": ["doctor", "install", "build", "lint", "typecheck", "test", "start"] } }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "checkId", "strength", "where", "result", "summary", "at"],
        "properties": {
          "id": { "type": "string", "pattern": "^ev-\\d{3,}$" },
          "strength": { "enum": ["asserted", "static", "executed", "clean_replay", "outcome_validated"] },
          "where": { "enum": ["static", "host", "fresh_copy", "disposable_vm", "container"] },
          "result": { "enum": ["pass", "fail", "not_run"] },
          "attribution": { "type": "object", "required": ["verdict", "basis", "detail"], "properties": { "verdict": { "enum": ["repo", "environment", "undetermined"] }, "basis": { "enum": ["experiment", "canary", "known_cause"] }, "changed": { "enum": ["network", "image", "tool"] } } },
          "network": { "enum": ["on"] }
        }
      }
    },
    "mutants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "component", "result", "exitCodes"],
        "properties": { "result": { "enum": ["caught", "survived", "discarded", "not_run"] } }
      }
    },
    "waivers": {
      "type": "object",
      "required": ["file", "digest", "entries", "rejected", "ignored"],
      "properties": { "entries": { "type": "array", "maxItems": 50 }, "rejected": { "type": "array" } }
    },
    "sealed": {
      "type": "object",
      "required": ["at", "digest", "reportJsonDigest", "reportMdDigest"],
      "properties": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    }
  }
}
