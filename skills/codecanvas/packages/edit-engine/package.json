{
  "name": "@codecanvas/edit-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Path-contained, pre-write validated, atomically journaled edit engine for codecanvas v2.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.27.0",
    "@codecanvas/protocol": "workspace:*",
    "postcss": "^8.5.3",
    "postcss-scss": "^4.0.9"
  }
}
