{
  "name": "@codecanvas/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local authenticated HTTP/WebSocket JSON-RPC, editor, and gateway daemon for codecanvas v2.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "codecanvas-daemon": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codecanvas/protocol": "workspace:*",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14"
  }
}
